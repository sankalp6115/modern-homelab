{
  "pages": [
    {
      "id": "media",
      "name": "Media",
      "icon": "/icons/spotify.png",
      "widgets": [
        "sys_volume",
        "app_volume"
      ],
      "buttons": [
        {
          "name": "Prev",
          "icon": "/icons/skip-prev.png",
          "action": {
            "type": "media",
            "cmd": "previous"
          }
        },
        {
          "name": "Play / Pause",
          "icon": "/icons/play.png",
