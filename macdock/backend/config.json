        "sys_volume",
        "app_volume"
      ],
      "buttons": [
        {
          "name": "Prev",
          "icon": "/icons/skip-prev.svg",
          "action": {
            "type": "media",
            "cmd": "previous"
          }
        },
        {
          "name": "Play / Pause",
          "icon": "/icons/play.svg",
